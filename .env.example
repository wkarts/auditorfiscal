# Identidade única da instalação (sem espaços). Troque wwsoftwares em cada stack.
COMPOSE_PROJECT_NAME=auditor-fiscal-wwsoftwares
INSTANCE_NAME=wwsoftwares
RESOURCE_PREFIX=auditor-fiscal-wwsoftwares

APP_NAME="Auditor Fiscal IBS/CBS - WWSoftware's"
APP_ENV=production
# Opcional no primeiro deploy: quando vazio, a API gera e persiste a mesma chave
# em ./api_storage/.app_key para API, scheduler e worker.
APP_KEY=
APP_DEBUG=false
APP_URL=https://auditor.wwsoftwares.com.br
APP_TIMEZONE=America/Sao_Paulo
FRONTEND_URL=https://auditor.wwsoftwares.com.br
ADMIN_EMAIL=wkarts@gmail.com
ADMIN_PASSWORD=

# source: compila os Dockerfiles locais; ghcr: baixa imagens publicadas no GHCR.
DEPLOY_MODE=source
GHCR_REGISTRY=ghcr.io
# Imagens oficiais de @wkarts. Altere somente para usar um fork/outro registry.
GHCR_NAMESPACE=wkarts
# `latest` acompanha automaticamente a release mais recente. Para rollback ou
# homologação reprodutível, fixe temporariamente uma versão publicada.
AUDITOR_IMAGE_TAG=latest

# Contrato de imagens do Dockge. Altere o namespace somente para usar um fork.
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=wkarts
APP_IMAGE_TAG=latest
API_BASE_IMAGE=ghcr.io/wkarts/auditorfiscal-api-base:php8.4-v1
LOCAL_API_IMAGE=auditor-fiscal/api:dev

# Serviços auxiliares versionados. Prefira tags com digest após homologação.
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:8-alpine
RABBITMQ_IMAGE=rabbitmq:4-management-alpine
MINIO_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
STORAGE_INIT_IMAGE=alpine:3.22
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest
API_RUNTIME_UID=82
API_RUNTIME_GID=82

# Porta HTTP local consumida exclusivamente pelo proxy reverso do CloudPanel.
# Use 0.0.0.0 somente quando o proxy estiver em outro host e proteja a porta
# com firewall permitindo apenas o endereço desse proxy.
WEB_BIND_HOST=127.0.0.1
WEB_PUBLISHED_PORT=8080
AUDITOR_DOMAIN=auditor.wwsoftwares.com.br

DB_CONNECTION=pgsql
DB_HOST=auditor-fiscal-postgres
DB_PORT=5432
DB_DATABASE=auditor_fiscal
DB_USERNAME=auditor
# Caracteres reservados como @, :, / e ? são aceitos sem codificação manual.
DB_PASSWORD=

REDIS_HOST=auditor-fiscal-redis
REDIS_PORT=6379
# Quando preenchido, o próprio serviço Redis habilita requirepass com este valor.
REDIS_PASSWORD=
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=auditor-fiscal-rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=auditor
RABBITMQ_PASSWORD=
RABBITMQ_VHOST=/
RABBITMQ_QUEUES=high,default,reports

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=auditor
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=auditor-fiscal
AWS_ENDPOINT=http://auditor-fiscal-minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true
# Opcional. Quando vazias, as credenciais AWS reutilizam MINIO_ROOT_USER e
# MINIO_ROOT_PASSWORD. Para AWS S3 com SSE-S3, use AES256; no MinIO sem KMS,
# mantenha vazio.
S3_SERVER_SIDE_ENCRYPTION=

FISCAL_ENGINE_URL=http://auditor-fiscal-engine:8000
FISCAL_ENGINE_TOKEN=
MAX_UPLOAD_MB=500
ZIP_MAX_FILES=50000
ZIP_MAX_UNCOMPRESSED_MB=4096

MINIO_ROOT_USER=auditor
MINIO_ROOT_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Rotação de logs Docker.
LOG_MAX_SIZE=20m
LOG_MAX_FILES=5
