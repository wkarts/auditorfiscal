APP_NAME="Auditor Fiscal IBS/CBS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://auditor.exemplo.com.br
APP_TIMEZONE=America/Sao_Paulo
ADMIN_EMAIL=admin@exemplo.com.br
ADMIN_PASSWORD=replace-me
FRONTEND_URL=https://auditor.exemplo.com.br

# source = compila localmente; ghcr = baixa imagens publicadas no GitHub Packages
DEPLOY_MODE=ghcr
GHCR_REGISTRY=ghcr.io
GHCR_NAMESPACE=wkarts
AUDITOR_IMAGE_TAG=latest

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=auditor_fiscal
DB_USERNAME=auditor
DB_PASSWORD=troque_esta_senha

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=rabbitmq
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=auditor
RABBITMQ_PASSWORD=troque_esta_senha
RABBITMQ_VHOST=/

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=auditor
AWS_SECRET_ACCESS_KEY=troque_esta_senha
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=auditor-fiscal
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

FISCAL_ENGINE_URL=http://fiscal-engine:8000
FISCAL_ENGINE_TOKEN=troque-token-interno
MAX_UPLOAD_MB=500
ZIP_MAX_FILES=50000
ZIP_MAX_UNCOMPRESSED_MB=4096

MINIO_ROOT_USER=auditor
MINIO_ROOT_PASSWORD=troque_esta_senha
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=troque_esta_senha
CADDY_EMAIL=admin@exemplo.com.br
AUDITOR_DOMAIN=auditor.exemplo.com.br
